APP_NAME=SENTRAVAX
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Connection (PostgreSQL 14+ with PostGIS 3.0+ required)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sentravax_db
DB_USERNAME=postgres
DB_PASSWORD=secret

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Storage & Queue
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail Configuration
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@sentravax.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# External Data Feeds & Telemetry
BMKG_AUTOGEMPA_URL=https://data.bmkg.go.id/DataMKG/TEWS/autogempa.json
EXTERNAL_HTTP_TIMEOUT=5

# Gemini AI / LLM Configuration (Deterministic fallback active if unavailable)
GEMINI_API_KEY=
AI_EVALUATION_MODEL=gemini-2.0-flash
